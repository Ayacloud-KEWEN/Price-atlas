# ====== Price Atlas 环境变量示例 ======
# 复制为 .env 并修改。不要把 .env 提交到代码仓库。

# 单用户登录
ADMIN_USERNAME=admin
# 必填：请改为强密码（>= 10 位）
ADMIN_PASSWORD=change-me-to-a-strong-password
# 必填：用于签名登录会话的随机字符串（>= 32 位），可用 `openssl rand -hex 32` 生成
SESSION_SECRET=replace-with-64-hex-chars
# 会话有效天数
SESSION_DAYS=30
# 通过 HTTPS 访问时设为 true（家庭局域网 http 访问保持 false）
COOKIE_SECURE=false

# 数据库（docker compose 内部使用 db 服务名）
POSTGRES_USER=priceatlas
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=priceatlas
# 本地不用 docker 时使用，例如 npm run db:dev 的内嵌库：
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5455/postgres

# 照片存储目录（容器内路径，已挂载为持久卷）
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
MAX_PHOTOS_PER_RECORD=12

# 对外端口
APP_PORT=3000
